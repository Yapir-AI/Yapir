model GitProject {
  id           String          @id @default(uuid()) @db.Uuid
  originId     String
  url          String
  name         String
  fullName     String
  providerType GitProviderType
  creationDate DateTime        @default(now())
  reviewers    Reviewer[]
  reviews      Review[]
}

model GithubConnector {
  id            Int      @id
  slug          String
  pem           String
  webhookSecret String
  creationDate  DateTime @default(now())
}

model GitlabConnector {
  id                String    @id @default(uuid()) @db.Uuid
  url               String
  applicationId     String
  applicationSecret String
  groupName         String?
  displayName       String
  creationDate      DateTime  @default(now())
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  redirectUri       String
}

model Instructions {
  id      String @id @default(uuid()) @db.Uuid
  title   String
  content String @default("")
}

model AiProvider {
  id       String         @id @default(uuid()) @db.Uuid
  type     AiProviderType
  enabled  Boolean        @default(false)
  baseUrl  String?
  apiKey   String?
  model    String
  reviewer Reviewer[]
}

model Review {
  id         String       @id @default(uuid()) @db.Uuid
  at         DateTime     @default(now())
  messages   Json
  status     ReviewStatus @default(PENDING)
  pullNumber BigInt
  pullUrl    String
  pullName   String
  projectId  String       @db.Uuid
  project    GitProject   @relation(fields: [projectId], references: [id])
  reviewerId String       @db.Uuid
  reviewer   Reviewer     @relation(fields: [reviewerId], references: [id])
}

model Reviewer {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  aiProviderId String       @db.Uuid
  aiProvider   AiProvider   @relation(fields: [aiProviderId], references: [id])
  projects     GitProject[]
  reviews      Review[]
}

enum GitProviderType {
  GITHUB
  GITLAB
}

enum AiProviderType {
  ANTHROPIC
  OPENAI
  OPENAI_LIKE
  OLLAMA
  MISTRAL
}

enum ReviewStatus {
  REVIEWED
  PENDING
  ERROR
}
