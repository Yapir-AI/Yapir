model GitProject {
  id            String          @id @default(uuid(7)) @db.Uuid
  originId      String
  url           String
  name          String
  fullName      String
  providerType  GitProviderType
  createdAt     DateTime        @default(now())
  ignoreDraft   Boolean         @default(true)
  ignoreList    String?
  ignorePattern String?
  reviewers     Reviewer[]
  mergeRequests MergeRequest[]
  connectorId   String          @db.Uuid
  connector     GitConnector    @relation(fields: [connectorId], references: [id])

  @@unique([originId, connectorId])
}

model GitConnector {
  id        String          @id @default(uuid(7)) @db.Uuid
  type      GitProviderType
  config    String /// @encrypted
  createdAt DateTime        @default(now())
  projects  GitProject[]
}

model AiProvider {
  id       String         @id @default(uuid(7)) @db.Uuid
  type     AiProviderType
  baseUrl  String?
  apiKey   String? /// @encrypted
  model    String
  reviewer Reviewer[]
}

model MergeRequest {
  id              String     @id @default(uuid(7)) @db.Uuid
  originId        String
  name            String
  url             String
  sourceBranch    String
  targetBranch    String
  authorName      String
  authorAvatarUrl String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  reviews         Review[]
  projectId       String     @db.Uuid
  project         GitProject @relation(fields: [projectId], references: [id])

  @@unique([originId, projectId])
}

model Review {
  id             String       @id @default(uuid(7)) @db.Uuid
  at             DateTime     @default(now())
  /// [GitMergeRequestDiffs]
  diffs          Json
  status         ReviewStatus @default(PENDING)
  errorMessage   String?
  reviewerId     String       @db.Uuid
  reviewer       Reviewer     @relation(fields: [reviewerId], references: [id])
  mergeRequestId String       @db.Uuid
  mergeRequest   MergeRequest @relation(fields: [mergeRequestId], references: [id])
  comments       Comment[]
}

model Comment {
  id         String          @id @default(uuid(7)) @db.Uuid
  location   CommentLocation
  fileId     String          @db.Uuid
  line       Int
  text       String
  createdAt  DateTime        @default(now())
  thumbsUp   Int             @default(0)
  thumbsDown Int             @default(0)
  reviewId   String          @db.Uuid
  review     Review          @relation(fields: [reviewId], references: [id])
}

model Reviewer {
  id                     String       @id @default(uuid(7)) @db.Uuid
  name                   String
  aiProviderId           String       @db.Uuid
  aiProvider             AiProvider   @relation(fields: [aiProviderId], references: [id])
  systemPrompt           String?
  systemPromptEnabled    Boolean      @default(false)
  useProjectInstructions Boolean      @default(true)
  projects               GitProject[]
  reviews                Review[]
}

enum GitProviderType {
  GITLAB
}

enum AiProviderType {
  ANTHROPIC
  OPENAI
  OPENAI_LIKE
  OLLAMA
  MISTRAL
}

enum ReviewStatus {
  REVIEWED
  PENDING
  ERROR
}

enum CommentLocation {
  OLD
  NEW
}
