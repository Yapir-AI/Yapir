model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model GitProject {
  id                    String          @id @default(uuid(7)) @db.Uuid
  originId              String
  url                   String
  name                  String
  fullName              String
  providerType          GitProviderType
  createdAt             DateTime        @default(now())
  ignoreDraft           Boolean         @default(true)
  ignoreList            String?
  ignorePattern         String?
  instructionFile       String?
  customInstructionFile Boolean         @default(false)
  reviewers             Reviewer[]
  mergeRequests         MergeRequest[]
  connectorId           String          @db.Uuid
  connector             GitConnector    @relation(fields: [connectorId], references: [id])

  @@unique([originId, connectorId])
}

model GitConnector {
  id        String          @id @default(uuid(7)) @db.Uuid
  type      GitProviderType
  config    String /// @encrypted
  createdAt DateTime        @default(now())
  projects  GitProject[]
}

model AiProvider {
  id       String         @id @default(uuid(7)) @db.Uuid
  type     AiProviderType
  baseUrl  String?
  apiKey   String? /// @encrypted
  model    String
  reviewer Reviewer[]
}

model MergeRequest {
  id              String     @id @default(uuid(7)) @db.Uuid
  originId        String
  name            String
  url             String
  sourceBranch    String
  targetBranch    String
  authorName      String
  authorAvatarUrl String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  reviews         Review[]
  projectId       String     @db.Uuid
  project         GitProject @relation(fields: [projectId], references: [id])

  @@unique([originId, projectId])
}

model Review {
  id             String       @id @default(uuid(7)) @db.Uuid
  at             DateTime     @default(now())
  /// [GitMergeRequestDiffs]
  diffs          Json
  addedLines     Int
  removedLines   Int
  status         ReviewStatus @default(PENDING)
  errorMessage   String?
  mergeRequestId String       @db.Uuid
  mergeRequest   MergeRequest @relation(fields: [mergeRequestId], references: [id])
  comments       Comment[]
  reviewNotes    ReviewNote[]
  reviewers      Reviewer[]
}

model Comment {
  id         String          @id @default(uuid(7)) @db.Uuid
  location   CommentLocation
  fileId     String
  line       Int
  text       String
  createdAt  DateTime        @default(now())
  thumbsUp   Int             @default(0)
  thumbsDown Int             @default(0)
  reviewId   String          @db.Uuid
  review     Review          @relation(fields: [reviewId], references: [id])
  reviewerId String          @db.Uuid
  reviewer   Reviewer        @relation(fields: [reviewerId], references: [id])
}

model NoteDefinition {
  id              String       @id @default(uuid(7)) @db.Uuid
  title           String
  tag             String       @unique
  systemPrompt    String
  publishToOrigin Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  reviewers       Reviewer[]
  reviewNotes     ReviewNote[]
}

model ReviewNote {
  id               String         @id @default(uuid(7)) @db.Uuid
  content          String
  createdAt        DateTime       @default(now())
  reviewId         String         @db.Uuid
  review           Review         @relation(fields: [reviewId], references: [id])
  reviewerId       String         @db.Uuid
  reviewer         Reviewer       @relation(fields: [reviewerId], references: [id])
  noteDefinitionId String         @db.Uuid
  noteDefinition   NoteDefinition @relation(fields: [noteDefinitionId], references: [id])

  @@unique([reviewId, reviewerId, noteDefinitionId])
}

model Reviewer {
  id                     String           @id @default(uuid(7)) @db.Uuid
  name                   String
  aiProviderId           String           @db.Uuid
  aiProvider             AiProvider       @relation(fields: [aiProviderId], references: [id])
  systemPrompt           String?
  systemPromptEnabled    Boolean          @default(false)
  useProjectInstructions Boolean          @default(true)
  projects               GitProject[]
  reviews                Review[]
  comments               Comment[]
  reviewNotes            ReviewNote[]
  noteDefinitions        NoteDefinition[]
}

enum GitProviderType {
  GITLAB
  GITHUB
}

enum AiProviderType {
  ANTHROPIC
  OPENAI
  OPENAI_LIKE
  OLLAMA
  MISTRAL
  DEEPSEEK
  GOOGLE_GENERATIVE
}

enum ReviewStatus {
  REVIEWED
  PENDING
  ERROR
}

enum CommentLocation {
  OLD
  NEW
}

enum ReviewNoteType {
  TECHNICAL_SUMMARY
  GENERAL_ASSESSMENT
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
